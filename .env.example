# Public URL the console CTA points to once the live agent ships
NEXT_PUBLIC_BEVMARD_URL=https://bevmaq.com/buy

# Early-access gate (src/proxy.ts). GATE=off opens the site; unset or any other value keeps the gate on.
GATE=
# Extra team emails, comma-separated, case-insensitive (@bevmaq.com is always team)
GATE_ALLOW=
# Public early-adopter sign-up: only "on" enables it; unset or anything else = closed mode (team only)
GATE_PUBLIC=
# HMAC key for the session cookie: openssl rand -hex 32
GATE_SESSION_SECRET=
# Google Identity Services OAuth client id (the sign-in button and ID-token audience)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Private Vercel Blob store for the early-adopter registry (shared with demo.bevmaq.com)
BLOB_READ_WRITE_TOKEN=
# Telegram ping on a first registration (production only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
